CMD: python3 -c "
import struct, json, os

def audit_elf(filepath):
    with open(filepath, 'rb') as f:
        data = f.read(64)
        magic = data[:4]
        ei_class = data[4] # 2 = 64-bit
        ei_data = data[5]  # 1 = little endian
        e_machine = struct.unpack('<H', data[18:20])[0] # 183 = AArch64 (0xB7)
    
    # check strings for DT_NEEDED
    with open(filepath, 'rb') as f:
        content = f.read()
    has_vulkan = b'libvulkan.so' in content
    has_opencl = b'libOpenCL.so' in content
    has_libcxx = b'libc++_shared.so' in content
    has_libomp = b'libomp.so' in content

    return {
        'is_elf': magic == b'\x7fELF',
        'is_elf64': ei_class == 2,
        'is_aarch64': e_machine == 183,
        'has_vulkan': has_vulkan,
        'has_opencl': has_opencl,
        'has_libcxx': has_libcxx,
        'has_libomp': has_libomp
    }

res = {
    'baseline_bin': audit_elf('/data/data/com.termux/files/home/tmp/termux-diffusion-a35-v130-validation/baseline/bin/sd-cli'),
    'baseline_libcxx': audit_elf('/data/data/com.termux/files/home/tmp/termux-diffusion-a35-v130-validation/baseline/lib/libc++_shared.so'),
    'baseline_libomp': audit_elf('/data/data/com.termux/files/home/tmp/termux-diffusion-a35-v130-validation/baseline/lib/libomp.so'),
    'opt_bin': audit_elf('/data/data/com.termux/files/home/tmp/termux-diffusion-a35-v130-validation/optimized/bin/sd-cli'),
    'opt_libcxx': audit_elf('/data/data/com.termux/files/home/tmp/termux-diffusion-a35-v130-validation/optimized/lib/libc++_shared.so'),
    'opt_libomp': audit_elf('/data/data/com.termux/files/home/tmp/termux-diffusion-a35-v130-validation/optimized/lib/libomp.so'),
}
print(json.dumps(res))
